#!/usr/bin/env bash
# =============================================================================
# LAMB Academic - hook pre-commit: bloquea commits que contengan secretos.
#
# Activar (una vez por clon):   git config core.hooksPath .githooks
# Desactivar:                   git config --unset core.hooksPath
# Omitir en un caso justificado: git commit --no-verify   (no recomendado)
#
# Reglas:
#  1. No se permite preparar archivos .env (salvo *.env.example), respaldos .dmp ni infra/backups/.
#  2. Ningun valor de las claves *PASSWORD* de backend/.env, infra/.env e infra/secretos/*.env puede aparecer en las
#     lineas agregadas. Los valores se leen en el momento del commit: nunca se guardan en el repo.
#  3. En archivos de configuracion no se permiten claves literales (password: valor). Se aceptan
#     referencias ${VARIABLE}, marcadores <...> y valores vacios.
# Los valores nunca se imprimen: solo el archivo y la regla incumplida.
# =============================================================================
set -uo pipefail

raiz="$(git rev-parse --show-toplevel)"
fallo=0

# Regla 1: archivos sensibles preparados
while IFS= read -r archivo; do
  [ -z "$archivo" ] && continue
  case "$archivo" in
    *.env.example) ;;
    .env|*/.env|*.env|*.dmp|infra/backups/*)
      echo "pre-commit: archivo sensible preparado: $archivo"
      fallo=1 ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# Lineas agregadas, agrupadas por archivo: "ruta<TAB>linea"
agregadas() {
  git diff --cached -U0 --diff-filter=ACMR --no-color -- "$@" | awk '
    /^\+\+\+ b\// { archivo = substr($0, 7); next }
    /^\+/ && !/^\+\+\+/ { print archivo "\t" substr($0, 2) }'
}

# Regla 2: valores reales de los .env locales
for envf in "$raiz/backend/.env" "$raiz/infra/.env" "$raiz"/infra/secretos/*.env; do
  [ -f "$envf" ] || continue
  origen="${envf#$raiz/}"
  while IFS='=' read -r clave valor || [ -n "$clave" ]; do
    valor="${valor%$'\r'}"
    case "$clave" in *PASSWORD*) ;; *) continue ;; esac
    [ "${#valor}" -ge 4 ] || continue
    archivos="$(agregadas | awk -F'\t' -v v="$valor" 'index($0, v) { print $1 }' | sort -u)"
    if [ -n "$archivos" ]; then
      while IFS= read -r a; do
        echo "pre-commit: el valor de $clave ($origen) aparece en: $a"
      done <<< "$archivos"
      fallo=1
    fi
  done < "$envf"
done

# Regla 3: claves literales en configuracion
patron='(password|passwd|pwd|secret|token|api[_-]?key|client[_-]?secret)["'\'']?[[:space:]]*[:=][[:space:]]*["'\'']?[^[:space:]"'\''$<{][^[:space:]"'\'']*'
# package-lock.json se excluye de esta regla: es generado y contiene nombres de paquetes como
# "@inquirer/password"; la regla 2 (valores reales) lo sigue revisando.
literales="$(agregadas '*.yml' '*.yaml' '*.properties' '*.env' '*.conf' '*.json' '*.xml' '*.sql'   ':(exclude)*package-lock.json' \
  | grep -iE "$patron" | grep -viE '\$\{[A-Za-z_]+' | cut -f1 | sort -u)"
if [ -n "$literales" ]; then
  while IFS= read -r a; do
    echo "pre-commit: posible clave literal en: $a (use \${VARIABLE} y el archivo .env)"
  done <<< "$literales"
  fallo=1
fi

if [ "$fallo" -ne 0 ]; then
  echo "pre-commit: commit bloqueado. Quite el secreto del cambio (git restore --staged <archivo>)."
  exit 1
fi
exit 0
